# Fixed relay server URL used by the pygame online flow.
# This is deployment configuration, not player input.
# Players only host or join with room codes inside the game UI.
#
# Accepted forms:
#   tcp://127.0.0.1:5051
#   127.0.0.1:5051
#   your-fixed-relay-domain.com:5051
UNO_RELAY_URL=tcp://127.0.0.1:5051
